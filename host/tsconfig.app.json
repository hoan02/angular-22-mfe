/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "./shared-ui/button/src/index.ts",
    "./shared-ui/input/src/index.ts",
    "./shared-ui/label/src/index.ts",
    "./shared-ui/card/src/index.ts",
    "./shared-ui/switch/src/index.ts",
    "./shared-ui/utils/src/index.ts",
    "./shared-ui/badge/src/index.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
